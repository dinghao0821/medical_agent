# ============================================================
# Multi-Agent Medical Assistant - Environment Variables
# ============================================================
# Copy this file to .env and fill in your API keys:
#   copy .env.example .env
# ============================================================

# OpenAI-compatible LLM Configuration
# For DashScope (Alibaba Cloud): OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# For OpenAI: OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# Model Configuration
MODEL_NAME=qwen3-max
VISION_MODEL=qwen-vl-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1536

# Speech API Key (Free credits available with new Eleven Labs Account)
# https://elevenlabs.io/
ELEVEN_LABS_API_KEY=

# Web Search API Key (Free credits available with new Tavily Account)
# https://tavily.com/
TAVILY_API_KEY=

# Hugging Face Token - using reranker model "ms-marco-TinyBERT-L-6"
# https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# (OPTIONAL) If using Qdrant server version, local does not require API key
QDRANT_URL=
QDRANT_API_KEY=

# ============================================================
# Server / Scale-out (all optional; sensible defaults shown)
# ============================================================
# HTTP bind host/port for the app.
HOST=0.0.0.0
PORT=8000
# Debug mode (default false for production safety).
DEBUG=false
# Number of gunicorn/uvicorn workers (used by the container CMD).
WORKERS=2
# Max medical image upload size in MB.
MAX_IMAGE_UPLOAD_SIZE=5

# LangGraph checkpointer backend: "memory" (single process, local dev) or
# "redis" (share session state across workers/replicas + persist HITL pauses).
# Falls back to in-memory automatically if Redis is unavailable.
CHECKPOINTER_BACKEND=memory
# Redis connection string, required when CHECKPOINTER_BACKEND=redis.
# Example: redis://localhost:6379/0  (in docker-compose: redis://redis:6379/0)
REDIS_URL=

# ============================================================
# Agent modernization feature switches (optional)
# ============================================================
# Agentic RAG (CRAG / Self-RAG): document-relevance grading + hallucination /
# answer self-reflection. Set false to restore the original RAG behaviour.
ENABLE_CRAG=true
# Minimum ratio of relevant retrieved docs before falling back to web search.
CRAG_RELEVANCE_THRESHOLD=0.5

# SSE token streaming endpoint (/chat/stream). The classic /chat is unaffected.
ENABLE_STREAMING=true
# True token-level streaming (native LLM .stream()) for conversational answers.
# Off => the previous word-chunking behaviour. RAG/web/vision paths always
# fall back to word-chunking regardless.
STREAM_TOKEN_LEVEL=false

# Deep Research Agent (Plan-and-Execute + Reflection multi-step research).
# Off by default (opt-in, heavier flow). When on, it becomes a routing target.
ENABLE_DEEP_RESEARCH=false
DEEP_RESEARCH_MAX_STEPS=4
DEEP_RESEARCH_MAX_REFLECTIONS=1
# Fan out independent sub-questions concurrently, then merge in plan order.
DEEP_RESEARCH_PARALLEL=true
DEEP_RESEARCH_MAX_WORKERS=4
# Warn when fewer than this ratio of findings have traceable sources.
DEEP_RESEARCH_EVIDENCE_MIN_COVERAGE=0.6

# Adaptive multi-agent deliberation for high-stakes medical responses.
# Runs specialist reviews in parallel only when a deterministic risk gate fires.
# Disabled by default because it adds model calls and latency.
ENABLE_AGENT_DELIBERATION=false
AGENT_DELIBERATION_MAX_REVIEWERS=3
AGENT_DELIBERATION_ROLES=geriatric medicine safety reviewer,clinical pharmacist and contraindication reviewer,evidence and uncertainty reviewer

# ============================================================
# P2: Caching & Rate limiting (optional; both need Redis, degrade gracefully)
# ============================================================
# Response cache for repeated queries. Off by default (ignores per-session
# context; best for stateless factual queries). No-ops without Redis.
ENABLE_CACHE=false
CACHE_TTL=3600

# Distributed rate limiting (fixed window, shared across workers via Redis;
# in-memory fallback + fail-open when Redis unavailable). Off by default.
ENABLE_RATE_LIMIT=false
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------
# P2: Object storage for uploads / segmentation outputs (optional)
# ------------------------------------------------------------
# backend: "local" (default, on-disk + /uploads) or "s3" (MinIO/AWS S3).
# Any S3 failure falls back to local disk automatically.
OBJECT_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=medical-assistant
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
# Optional public base URL / CDN prefix used when building object URLs.
S3_PUBLIC_BASE_URL=

# ------------------------------------------------------------
# P2: Async task queue (Celery + Redis) for heavy jobs (optional)
# ------------------------------------------------------------
# When false (default), /ingest runs synchronously in-process (no broker needed).
# When true, jobs are dispatched to Celery workers; poll status via /tasks/{id}.
ENABLE_TASK_QUEUE=false
# Broker / result backend (default to REDIS_URL if unset). Using DB 1 keeps queue
# data separate from the checkpointer/cache on DB 0.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ============================================================
# P3: Authentication / Authorization / Compliance (optional)
# ============================================================
# When false (default), endpoints are NOT protected (behaves as before).
# When true: /chat /upload /chat/stream require a JWT; /validate requires the
# doctor or admin role. The FIRST registered user becomes admin.
ENABLE_AUTH=false
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
# Applies ONLY when refresh tokens are OFF (see ENABLE_REFRESH_TOKEN below).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Refresh tokens + revocation (opt-in) ----
# When true: /auth/login returns a short-lived access token + a long-lived
# refresh token; /auth/refresh rotates them; /auth/logout revokes tokens via a
# jti denylist. When false (default), login behaves exactly as before.
ENABLE_REFRESH_TOKEN=false
# Access-token lifetime (minutes) used only when ENABLE_REFRESH_TOKEN=true.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh-token lifetime (minutes); default 7 days.
REFRESH_TOKEN_TTL_MINUTES=10080
# Redis URL for the revocation denylist (shared across workers/replicas).
# Falls back to REDIS_URL when unset. Without Redis, revocation degrades to a
# single-process in-memory store (fine for dev / single worker).
AUTH_REDIS_URL=

# Database for users + audit logs. Empty -> local SQLite (data/app.db).
# For PostgreSQL: postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=

# Compliance
ENABLE_AUDIT=true            # write audit trail for chat/upload/validate
ENABLE_PII_MASKING=true      # mask emails/phones/IDs before storing audit detail
# Optional Fernet key to encrypt audit 'detail' at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AUDIT_ENCRYPTION_KEY=

# ============================================================
# P4: Observability (metrics / logging / tracing)
# ============================================================
# Prometheus metrics at GET /metrics (cheap; on by default).
ENABLE_METRICS=true
# JSON structured logs (useful for Loki/ELK). Off by default.
ENABLE_JSON_LOGS=false
LOG_LEVEL=INFO

# LangSmith agent tracing (off by default). When on, set the API key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-assistant

# ============================================================
# Agent hardening: prompt-injection defence & tracing
# ============================================================
# Local prompt-injection defence (no LLM cost, no new deps). On by default and
# fail-open. Blocks instruction-override/exfiltration in user input, fences
# untrusted retrieved/web content as data, and redacts leaked prompts/secrets.
ENABLE_AGENT_SECURITY=true
# Fence untrusted retrieved/web content so the model treats it as data.
SECURITY_WRAP_UNTRUSTED=true
# Redact leaked system prompt / secret patterns from responses.
SECURITY_SCAN_OUTPUT=true

# Structured per-request agent trace (routing/guardrail/retrieval as JSON logs).
# Off by default; enable to get one 'agent_trace {...}' log line per request.
ENABLE_AGENT_TRACE=false

# ============================================================
# Agent capability enhancements
# ============================================================
# Cross-session long-term memory (user_id-keyed durable facts: conditions,
# allergies, meds, preferences). Off by default. Auto-extraction uses the LLM.
ENABLE_LONG_TERM_MEMORY=false
MEMORY_AUTO_EXTRACT=true
MEMORY_REDIS_URL=

# Structured tools (BMI / unit conversion / drug-info lookup). Off by default.
# When on, matching queries are answered deterministically without the LLM.
ENABLE_TOOLS=false
# LLM-driven ReAct tool calling: the model autonomously decides which tool(s) to
# call and can chain multiple steps. Falls back to keyword tools if unsupported.
ENABLE_TOOL_AGENT=false

# Sentence-level citation grounding for RAG answers: inline [n] markers mapped to
# retrieved sources + a confidence badge. Off by default.
ENABLE_CITATIONS=false

# ============================================================
# Cost governance / semantic cache / retrieval tuning
# ============================================================
# LLM cost & token-budget governance. Meters token usage per user/session; if a
# positive DAILY_TOKEN_BUDGET is set, over-budget requests are rejected (429).
ENABLE_COST_TRACKING=false
DAILY_TOKEN_BUDGET=0            # 0 => metering only (no hard limit)
COST_REDIS_URL=

# Semantic (embedding-similarity) response cache: reuse answers for
# semantically-similar queries. Complements the exact-match cache.
ENABLE_SEMANTIC_CACHE=false
SEMANTIC_CACHE_THRESHOLD=0.92   # cosine similarity needed for a hit
SEMANTIC_CACHE_MAX_ENTRIES=500

# Reranker (cross-encoder) model. Swap in a medical model for better relevance,
# e.g. pritamdeka/S-PubMedBert-MS-MARCO
RERANKER_MODEL=cross-encoder/ms-marco-TinyBERT-L-6
RERANKER_TOP_K=3

# Parent-child (small-to-big) retrieval: merge same-source retrieved chunks into
# larger parent context for richer generation. Off by default.
ENABLE_PARENT_CHILD_RETRIEVAL=false
PARENT_CHUNK_SIZE=2048

# Proactive clarification: ask a focused follow-up when a symptom description is
# too vague to answer usefully. Off by default.
ENABLE_CLARIFICATION=false

# Semantic conversation summarisation: compress older history into a recap once
# it exceeds the trigger, instead of hard truncation. Off by default.
ENABLE_CONVERSATION_SUMMARY=false
SUMMARY_TRIGGER_MESSAGES=20

# Emergency red-flag triage: detect critical symptoms (chest pain, stroke signs,
# self-harm, ...) and urge immediate care. ON by default (safety-first).
ENABLE_EMERGENCY_TRIAGE=true
